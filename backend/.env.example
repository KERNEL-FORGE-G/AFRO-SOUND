# Backend AFRO SOUND (Vercel) — variables d'environnement
# Copiez ce fichier en `backend/.env` (local) ou configurez-les dans Vercel.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Clé "service role" : NE JAMAIS exposer côté application (backend uniquement)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Jamendo (titres complets — clé gratuite : https://developer.jamendo.com/)
JAMENDO_CLIENT_ID=your-jamendo-client-id

# Port local (développement uniquement)
PORT=3000

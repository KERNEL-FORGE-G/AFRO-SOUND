# AFRO SOUND (application React Native) — variables d'environnement
# Copiez ce fichier en `.env`. NE committez JAMAIS le vrai `.env`.

# Supabase (clé publique "anon" — utilisable côté client)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# URL du backend déployé sur Vercel
BACKEND_URL=https://your-app.vercel.app
# Backend local (émulateur Android : 10.0.2.2 = localhost de la machine hôte)
DEV_BACKEND_URL=http://10.0.2.2:3000
